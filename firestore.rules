rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'bio',
          'photoURL',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.visibility in [
          'private',
          'friends',
          'public'
        ];
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && validProfile(userId);

      allow read: if isOwner(userId);

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'displayName',
            'bio',
            'photoURL',
            'visibility',
            'updatedAt'
          ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.visibility in [
          'private',
          'friends',
          'public'
        ];

      allow delete: if false;
    }

    match /posts/{postId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'text',
          'visibility',
          'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.visibility in [
          'public',
          'private'
        ]
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (
          resource.data.visibility == 'public'
          || resource.data.authorId == request.auth.uid
        );

      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
